{
  "version": "v3.0.0",
  "company": "AI One-Person Company OS",
  "platform": "抖店",
  "mode": "AI全自治为主 + 人工审批为辅",
  "initialized_at": null,

  "_safety": {
    "forbidden_auto": [
      "deploy.production", "git.merge", "pm2.restart",
      "server.write", "budget.increase", "campaign.enroll",
      "customer.high_risk_reply", "trading.order"
    ],
    "principle": "所有高危动作 requiresHumanApproval=true，仅 READ/PLAN/REPORT 动作全自治"
  },

  "organization": {
    "ceo": {
      "role": "CEO Agent",
      "level": 1,
      "domains": ["all"],
      "kpis": ["all"],
      "budgets": ["all"],
      "missions": ["all"],
      "responsibility": "全局决策、战略方向、最终审批权",
      "vote_weight": 2
    },
    "coo": {
      "role": "COO Agent",
      "level": 2,
      "domains": ["commerce", "customer"],
      "kpis": ["gmv", "refund_rate", "task_success_rate"],
      "budgets": ["server", "tool"],
      "missions": ["development", "deployment"],
      "responsibility": "日常运营、订单履约、退款处理",
      "vote_weight": 1
    },
    "cto": {
      "role": "CTO Agent",
      "level": 2,
      "domains": ["devops"],
      "kpis": ["agent_success_rate", "mission_completion_rate"],
      "budgets": ["server", "token", "tool"],
      "missions": ["development", "deployment", "autonomous"],
      "responsibility": "系统稳定性、Agent健康、CI/CD",
      "vote_weight": 1
    },
    "cmo": {
      "role": "CMO Agent",
      "level": 2,
      "domains": ["marketing", "commerce"],
      "kpis": ["gmv", "roi", "ctr", "cvr"],
      "budgets": ["ads", "campaign"],
      "missions": ["commerce", "report"],
      "responsibility": "推广投流、活动报名、ROI优化",
      "vote_weight": 1
    },
    "cfo": {
      "role": "CFO Agent",
      "level": 2,
      "domains": ["all"],
      "kpis": ["profit", "roi", "budget_usage_rate"],
      "budgets": ["all"],
      "missions": ["audit", "report"],
      "responsibility": "预算管控、利润分析、成本审计",
      "vote_weight": 1
    }
  },

  "kpi": {
    "targets": [
      {
        "type": "gmv",
        "target": 80000,
        "unit": "CNY/月",
        "alert_threshold": 50000,
        "danger_threshold": 30000,
        "description": "月度GMV目标 8万元"
      },
      {
        "type": "profit",
        "target": 24000,
        "unit": "CNY/月",
        "alert_threshold": 15000,
        "danger_threshold": 8000,
        "description": "月度净利润目标 2.4万元（毛利率30%）"
      },
      {
        "type": "roi",
        "target": 2.5,
        "unit": "",
        "alert_threshold": 1.8,
        "danger_threshold": 1.2,
        "description": "投流ROI目标 2.5"
      },
      {
        "type": "refund_rate",
        "target": 3,
        "unit": "%",
        "alert_threshold": 5,
        "danger_threshold": 8,
        "description": "退款率目标 < 3%"
      },
      {
        "type": "ctr",
        "target": 3.5,
        "unit": "%",
        "alert_threshold": 2.0,
        "danger_threshold": 1.0,
        "description": "点击率目标 > 3.5%"
      },
      {
        "type": "cvr",
        "target": 5.0,
        "unit": "%",
        "alert_threshold": 3.0,
        "danger_threshold": 1.5,
        "description": "转化率目标 > 5%"
      },
      {
        "type": "task_success_rate",
        "target": 95,
        "unit": "%",
        "alert_threshold": 85,
        "danger_threshold": 70,
        "description": "任务成功率 > 95%"
      },
      {
        "type": "agent_success_rate",
        "target": 98,
        "unit": "%",
        "alert_threshold": 90,
        "danger_threshold": 80,
        "description": "Agent成功率 > 98%"
      },
      {
        "type": "budget_usage_rate",
        "target": 80,
        "unit": "%",
        "alert_threshold": 95,
        "danger_threshold": 100,
        "description": "预算使用率控制在 80%以内"
      }
    ],
    "initial_measures": [
      { "type": "gmv", "value": 48200 },
      { "type": "profit", "value": 12300 },
      { "type": "roi", "value": 2.1 },
      { "type": "refund_rate", "value": 4.2 },
      { "type": "task_success_rate", "value": 92 },
      { "type": "agent_success_rate", "value": 96 }
    ]
  },

  "budget": {
    "total_monthly": 30000,
    "currency": "CNY",
    "items": [
      {
        "type": "ads",
        "name": "投流推广",
        "limit": 12000,
        "unit": "CNY/月",
        "requiresApproval": true,
        "description": "抖音千川/巨量千川投流预算"
      },
      {
        "type": "campaign",
        "name": "活动报名",
        "limit": 5000,
        "unit": "CNY/月",
        "requiresApproval": true,
        "description": "平台活动报名费、保证金"
      },
      {
        "type": "server",
        "name": "服务器",
        "limit": 3000,
        "unit": "CNY/月",
        "requiresApproval": false,
        "description": "云服务器、域名、CDN"
      },
      {
        "type": "token",
        "name": "AI Token",
        "limit": 5000,
        "unit": "CNY/月",
        "requiresApproval": false,
        "description": "GPT-4o/DeepSeek/Doubao API调用"
      },
      {
        "type": "tool",
        "name": "工具订阅",
        "limit": 2000,
        "unit": "CNY/月",
        "requiresApproval": false,
        "description": "数据分析工具、设计工具"
      },
      {
        "type": "risk_reserve",
        "name": "风险储备金",
        "limit": 3000,
        "unit": "CNY/月",
        "requiresApproval": false,
        "description": "退款垫付、纠纷处理备用金"
      }
    ]
  },

  "approval": {
    "rules": [
      {
        "type": "deploy.production",
        "level": "critical",
        "requiresHumanApproval": true,
        "approvers": ["CEO"],
        "auto_reject_timeout_minutes": 30,
        "description": "生产环境部署必须CEO审批"
      },
      {
        "type": "git.merge",
        "level": "critical",
        "requiresHumanApproval": true,
        "approvers": ["CTO", "CEO"],
        "auto_reject_timeout_minutes": 60,
        "description": "代码合并必须CTO或CEO审批"
      },
      {
        "type": "pm2.restart",
        "level": "high",
        "requiresHumanApproval": true,
        "approvers": ["CTO"],
        "auto_reject_timeout_minutes": 15,
        "description": "PM2重启必须CTO审批"
      },
      {
        "type": "server.write",
        "level": "high",
        "requiresHumanApproval": true,
        "approvers": ["CTO"],
        "auto_reject_timeout_minutes": 30,
        "description": "服务器写操作必须CTO审批"
      },
      {
        "type": "budget.increase",
        "level": "high",
        "requiresHumanApproval": true,
        "approvers": ["CFO", "CEO"],
        "auto_reject_timeout_minutes": 60,
        "description": "预算追加必须CFO+CEO审批"
      },
      {
        "type": "campaign.enroll",
        "level": "medium",
        "requiresHumanApproval": true,
        "approvers": ["CMO"],
        "auto_reject_timeout_minutes": 120,
        "description": "活动报名必须CMO审批"
      },
      {
        "type": "customer.high_risk_reply",
        "level": "high",
        "requiresHumanApproval": true,
        "approvers": ["COO"],
        "auto_reject_timeout_minutes": 30,
        "description": "高风险客户回复必须COO审批"
      },
      {
        "type": "trading.order",
        "level": "critical",
        "requiresHumanApproval": true,
        "approvers": ["CEO", "COO"],
        "auto_reject_timeout_minutes": 30,
        "description": "下单操作必须CEO或COO审批"
      },
      {
        "type": "trading.high_risk_alert",
        "level": "high",
        "requiresHumanApproval": true,
        "approvers": ["CFO", "COO"],
        "auto_reject_timeout_minutes": 60,
        "description": "高风险交易预警需CFO+COO确认"
      },
      {
        "type": "ad.budget.increase",
        "level": "medium",
        "requiresHumanApproval": true,
        "approvers": ["CMO", "CFO"],
        "auto_reject_timeout_minutes": 60,
        "description": "广告预算追加需CMO+CFO审批"
      }
    ],
    "auto_allow": [
      "report.write",
      "test.run",
      "staging.shadow",
      "server.audit",
      "audit.review",
      "risk.analysis",
      "code.review",
      "code.patch",
      "docs.write",
      "summary.write",
      "wecom.report",
      "mission.status",
      "git.branch.create",
      "git.diff",
      "git.pr.create"
    ]
  },

