# ================================================
#  Playwright Worker - 环境变量配置模板
#  使用方法: cp .env.example .env  (填入真实值)
# ================================================

# --- 抖店账号 ---
DOUDIAN_USERNAME=your_doudian_username
DOUDIAN_PASSWORD=your_doudian_password
DOUDIAN_SHOP_ID=your_shop_id

# --- 企业微信推送 ---
# 方式一: 企微官方 webhook
# WECOM_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
# 方式二: 自定义转发服务
# WECOM_BOT_WEBHOOK=https://your-domain.com/wecom/callback
# WECOM_CORP_ID=your_corp_id

# --- 代理（可选）---
# WECOM_PROXY=socks5h://127.0.0.1:1080

# --- Playwright ---
PLAYWRIGHT_PERSISTENT=false

# --- 部署路径（可选，默认 /opt/wecom-openclaw）---
# DEPLOY_PATH=/opt/wecom-openclaw
