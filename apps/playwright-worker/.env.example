# 抖店账号配置（fetch-orders 等模块用）
DOUDIAN_USERNAME=your_doudian_username
DOUDIAN_PASSWORD=your_doudian_password
DOUDIAN_SHOP_ID=your_shop_id

# 企业微信群机器人配置

# 方式一：企微官方 webhook（直连或走代理）
# WECOM_BOT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY_HERE

# 方式二：自定义转发服务（如 api.yudong.shop）
WECOM_BOT_WEBHOOK=https://api.yudong.shop/wecom/callback
WECOM_CORP_ID=wwb5c359f492d2b26b

# 服务器访问外网代理（可选）
# 例如：socks5h://127.0.0.1:1080
WECOM_PROXY=

# Playwright 配置
# 如需使用持久化登录态，设为 true；否则每次重新登录
PLAYWRIGHT_PERSISTENT=false

# 服务器部署路径（可选，默认 /opt/wecom-openclaw）
# DEPLOY_PATH=/opt/wecom-openclaw
