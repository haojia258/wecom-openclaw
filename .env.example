# ═══════════════════════════════════════════════════
#  抖店 AI 运营 OS - 环境变量配置
#  复制此文件为 .env 并填入真实值
#  cp .env.example .env
# ═══════════════════════════════════════════════════
BROWSER_STATE_PATH = "C:\data\browser\storageState.json"
# ─── 通用 ──────────────────────────────────────────
NODE_ENV=production

# ─── 企业微信配置 ──────────────────────────────────
# 企业ID（在企业微信管理后台 -> 我的企业 查看）
WECOM_CORP_ID=wwb5c359f492d2b26b

# 应用 Token（回调配置中设置）
WECOM_TOKEN=openclaw123

# EncodingAESKey（回调配置中生成）
WECOM_ENCODING_AES_KEY=MztjE4hEwftpfHvxcAwgG764kHsobGbYKjl3nbqACtL

# 企业微信群机器人 Webhook（用于推送日报）
# 格式: https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
WECOM_WEBHOOK_URL=https://api.yudong.shop/wecom/callback

# ─── 代理设置（访问外网用）──────────────────────────
HTTP_PROXY=http://127.0.0.1:8118
HTTPS_PROXY=http://127.0.0.1:8118

# ─── 服务端口 ──────────────────────────────────────
WECOM_ADAPTER_PORT=3001
PLAYWRIGHT_PORT=3002
ANALYTICS_PORT=3003

# ─── OpenClaw ──────────────────────────────────────
OPENCLAW_URL=http://openclaw:18789

# ─── Mock 模式（true = 不请求 OpenClaw，用本地 mock）──
USE_MOCK=true

# ─── MySQL ─────────────────────────────────────────
MYSQL_ROOT_PASSWORD=doudian123
MYSQL_DATABASE=doudian_os
MYSQL_USER=doudian
MYSQL_PASSWORD=doudian123

# ─── Redis ─────────────────────────────────────────
REDIS_PASSWORD=doudian123

# ─── 日报定时任务（cron 格式，默认每天 21:00）──────
REPORT_CRON=0 21 * * *

# ─── Playwright 路径 ────────────────────────────────
BROWSER_STATE_PATH=/data/browser/storageState.json
SCREENSHOT_DIR=/logs/screenshots
