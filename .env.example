# ================================================
#  DoudianOS - 环境变量配置模板
#  使用方法: cp .env.example .env  (填入真实值)
# ================================================

# --- 通用 ---
NODE_ENV=production

# --- 企业微信 ---
WECOM_CORP_ID=your_corp_id
WECOM_TOKEN=your_callback_token
WECOM_ENCODING_AES_KEY=your_encoding_aes_key
WECOM_WEBHOOK_URL=your_wecom_webhook_url

# --- 代理（访问外网用，按需配置）---
# HTTP_PROXY=http://127.0.0.1:8118
# HTTPS_PROXY=http://127.0.0.1:8118

# --- 服务端口 ---
WECOM_ADAPTER_PORT=3001
PLAYWRIGHT_PORT=3002
ANALYTICS_PORT=3003

# --- OpenClaw ---
OPENCLAW_URL=your_openclaw_url

# --- Mock 模式（true = 不请求 OpenClaw，用本地 mock）---
USE_MOCK=false

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=your_database
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=change_me

# --- Redis ---
REDIS_PASSWORD=change_me

# --- 日报定时任务（cron 格式，默认每天 21:00）---
REPORT_CRON=0 21 * * *

# --- Playwright 路径 ---
BROWSER_STATE_PATH=/data/browser/storageState.json
SCREENSHOT_DIR=/logs/screenshots
